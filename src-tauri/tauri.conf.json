{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mokost Anime Center",
  "version": "0.6.3",
  "identifier": "com.mokost.animecenter",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mokost Anime Center",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "url": "index.html",
        "center": true,
        "visible": true,
        "focus": true,
        "devtools": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ]
  }
}
